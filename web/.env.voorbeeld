# Kopieer naar .env.local (lokaal) of zet ze in Vercel → Settings → Environment Variables.
# De repo is openbaar: nooit echte waarden in GitHub zetten.

# Adres van de webinterface, zonder / aan het eind.
SITE_URL=https://keukenbot.vercel.app

# Supabase-project keukenbot
NEXT_PUBLIC_SUPABASE_URL=https://svdrzpwrksycuwyabmlv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen op de server gebruikt (Google-tokens opslaan, uitnodigen). Nooit NEXT_PUBLIC_ ervoor.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth-client van het type "Webapplicatie".
# Geautoriseerde omleidings-URI: <SITE_URL>/api/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Wie de beheerpagina ziet (monteurs uitnodigen, WhatsApp koppelen). Komma's ertussen.
BEHEERDERS=maartendejongejonge@gmail.com

# /opt/keukenbot/.env — alleen leesbaar voor de gebruiker keukenbot (chmod 600).
# Nooit in GitHub zetten.

# true = de klant krijgt NIETS, jij krijgt op MONTEUR_WHATSAPP te zien wat de
# bot gezegd zou hebben. Pas op false zetten na een week meelezen.
MEELEZEN=true

# Nummers als 31 + 9 cijfers, zonder + en zonder spaties.
# Let op: zet uitleg altijd op een eigen regel. systemd leest alles achter
# de = als waarde, ook een # met tekst erachter.
#
# Het wegwerpnummer waar de bot op draait:
WHATSAPP_NUMMER=31620236793
# Jouw eigen nummer, hier komen de meldingen van de runner zelf, en de
# seintjes van een monteur die in de webinterface nog geen eigen nummer heeft:
MONTEUR_WHATSAPP=

SUPABASE_URL=https://svdrzpwrksycuwyabmlv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Oude koppeling uit scripts/koppel-agenda.mjs. Alleen gebruikt voor een
# monteur die zijn agenda nog niet in de webinterface heeft gekoppeld.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_AGENDA_ID=primary

# De web-client van de webinterface (zelfde waarden als in Vercel). Agenda's
# die monteurs daar koppelen, horen bij deze client.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Stresstest: nummers van vrienden die klant spelen, gescheiden door komma's.
# 06-nummers mogen ook. Zij kunnen 'reset' sturen, de bot begint na inplannen
# opnieuw, hun afspraken komen als [TEST] in de agenda, en na elke update
# krijgen ze een bericht dat ze opnieuw kunnen testen.
# Leeg laten = geen testers. Niet in GitHub zetten: de repo is openbaar.
TESTNUMMERS=

# Seconden wachten na het laatste bericht van een klant voordat de bot
# antwoordt, zodat een onderdelenlijst + plattegrond + tekst één antwoord krijgen.
# BUNDEL_SECONDEN=15

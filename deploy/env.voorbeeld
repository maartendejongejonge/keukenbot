# /opt/keukenbot/.env — alleen leesbaar voor de gebruiker keukenbot (chmod 600).
# Nooit in GitHub zetten.

# true = de klant krijgt NIETS, jij krijgt op MONTEUR_WHATSAPP te zien wat de
# bot gezegd zou hebben. Pas op false zetten na een week meelezen.
MEELEZEN=true

# Nummers als 31 + 9 cijfers, zonder + en zonder spaties.
# Let op: zet uitleg altijd op een eigen regel. systemd leest alles achter
# de = als waarde, ook een # met tekst erachter.
#
# Het wegwerpnummer waar de bot op draait:
WHATSAPP_NUMMER=31620236793
# Jouw eigen nummer, hier komen de meldingen:
MONTEUR_WHATSAPP=

SUPABASE_URL=https://svdrzpwrksycuwyabmlv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_AGENDA_ID=primary
